# Copy to $XDG_CONFIG_HOME/miagent/.env (~/.config/miagent/.env by default).
# A .env in a project's state directory (.miagent/.env, next to the session
# file) is read after this one and overrides it; a variable exported in the
# shell overrides both.

# API information.
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# The session file to continue. Default: .miagent/session.jsonl, whose
# directory is created on demand.
# MIAGENT_SESSION=.miagent/session.jsonl

# The reasoning effort sent with every agent turn as the Responses API
# "reasoning.effort" field. Common values are minimal, low, medium, and high.
# Unset, "none", "off", or "default" sends no reasoning field, so the endpoint
# keeps its own default. Any other value is passed through unchanged, so a
# proxy or a local server may accept levels the OpenAI API does not name.
# /models lists the levels the endpoint reports for each model.
# OPENAI_REASONING_EFFORT=medium

# For the /context command and the context line printed after a normal run:
# the model's context window in tokens, used to report how full the session is.
# MIAGENT_CONTEXT_LIMIT=128000

# For the /compact command: how much of the recent conversation to keep, and
# the token budget the summary may use (the history summary gets 80% of it, a
# split turn's prefix summary 50%). Sizes come from the usage the provider
# reports, so a session that has run a turn is measured; only the text no
# request has carried yet is guessed, at about 4 characters per token (which
# undercounts code or JSON).
# MIAGENT_KEEP_RECENT_TOKENS=20000
# MIAGENT_RESERVE_TOKENS=16384
