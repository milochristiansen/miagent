# Copy to $MIAGENT_CONFIG_DIR/.env, which defaults to $XDG_CONFIG_HOME/miagent/.env (~/.config/miagent/.env).
# A .env in a project's state directory (.miagent/.env, next to the session file) is read first and overrides
# this one; a variable exported in the shell overrides both. The project local .env can set `MIAGENT_CONFIG_DIR`
# the global .env (for obvious reasons) cannot. If `MIAGENT_CONFIG_DIR` is not set, it will be set internally
# by the harness, so it is always present for tool programs, etc.

# API information.
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# The session file to continue. Default: .miagent/session.jsonl.
# Many of the session handling slash commands will only really work if the session is in the default location.
# MIAGENT_SESSION=.miagent/session.jsonl

# The reasoning effort sent with every agent turn as the Responses API "reasoning.effort" field. Common values are
# minimal, low, medium, and high. Unset, "none", "off", or "default" sends no reasoning field, so the endpoint
# keeps its own default. Any other value is passed through unchanged, so a  proxy or a local server may accept levels
# the OpenAI API does not name. /models lists the levels the endpoint reports for each model.
# OPENAI_REASONING_EFFORT=medium

# The model's context window in tokens, used to report context fullness in the /context command and after turn end.
# MIAGENT_CONTEXT_LIMIT=128000

# How many lines of each tool call section to show on a terminal: the pretty-printed arguments and the tool's
# output are each capped at this many rows. 0 shows everything; otherwise the value is reduced to the terminal
# height and defaults to 10. A capped output scrolls within the tool box rather than scrolling the screen. The
# cap does not apply when output is not a terminal.
# MIAGENT_TOOLCALL_SIZE=10

# For the /compact command: how much of the recent conversation to keep, and the token budget the summary may use (the
# history summary gets 80% of it, a split turn's prefix summary 50%). Sizes come from the usage the provider reports,
# so a session that has run a turn is measured; only the text no request has carried yet is guessed, at about 4
# characters per token (which undercounts code or JSON).
# MIAGENT_KEEP_RECENT_TOKENS=20000
# MIAGENT_RESERVE_TOKENS=16384
