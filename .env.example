# Copy to $MIAGENT_CONFIG_DIR/.env, which defaults to $XDG_CONFIG_HOME/miagent/.env (~/.config/miagent/.env).
# A .env in a project's state directory (.miagent/.env, next to the session file) is read first and overrides
# this one; a variable exported in the shell overrides both. The project local .env can set `MIAGENT_CONFIG_DIR`
# the global .env (for obvious reasons) cannot. If `MIAGENT_CONFIG_DIR` is not set, it will be set internally
# by the harness, so it is always present for tool programs, etc.

# API information.
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# Credentials for the deepseek-search tool, which exposes the DeepSeek Search
# and Fetch APIs. DEEPSEEK_SEARCH_API_KEY wins, then DEEPSEEK_API_KEY; if
# neither is set, the tool reuses OPENAI_API_KEY when OPENAI_MODEL names a
# DeepSeek model. With no likely key it does not advertise itself.
# DEEPSEEK_SEARCH_API_KEY=sk-your-key-here
# DEEPSEEK_API_KEY=sk-your-key-here

# The session file to continue. Default: .miagent/session.jsonl.
# Many of the session handling slash commands will only really work if the session is in the default location.
# MIAGENT_SESSION=.miagent/session.jsonl

# The reasoning effort sent with every agent turn as the Responses API "reasoning.effort" field. Common values are
# minimal, low, medium, and high. Unset, "none", "off", or "default" sends no reasoning field, so the endpoint
# keeps its own default. Any other value is passed through unchanged, so a  proxy or a local server may accept levels
# the OpenAI API does not name. /models lists the levels the endpoint reports for each model.
# OPENAI_REASONING_EFFORT=medium

# The model's context window in tokens, used to report context fullness in the /context command and after turn end.
# MIAGENT_CONTEXT_LIMIT=128000

# The share of the context window that must remain free before a new turn will start, as a percentage. When less
# than this is left, the harness prints a note and exits without calling the model, so a turn is not cut off against
# a full window; run /compact to shrink the session, then send the prompt again. Default 10; 0 disables the check.
# Needs MIAGENT_CONTEXT_LIMIT to have any effect.
# MIAGENT_CONTEXT_HEADROOM=10

# How many lines of each tool call section to show on a terminal: the pretty-printed arguments and the tool's
# output are each capped at this many rows. 0 shows everything; otherwise the value is reduced to the terminal
# height and defaults to 10. A capped output scrolls within the tool box rather than scrolling the screen, and
# the box headers report how many lines were elided. The cap does not apply when output is not a terminal.
# MIAGENT_TOOLCALL_SIZE=10

# For the /compact command: how much of the recent conversation to keep, and the token budget the summary may use (the
# history summary gets 80% of it, a split turn's prefix summary 50%). Sizes come from the usage the provider reports,
# so a session that has run a turn is measured; only the text no request has carried yet is guessed, at about 4
# characters per token (which undercounts code or JSON).
# MIAGENT_KEEP_RECENT_TOKENS=20000
# MIAGENT_RESERVE_TOKENS=16384

# Attachment retention and request budgets. Sizes use classic binary units:
# KB = 1024 bytes, MB = 1024 KB. Bare integers are bytes.
# Attachments live in per-session directories under .miagent/attachments/<session-name>.
# Large tool-result bodies are externalized and pruned separately.
# MIAGENT_ATTACHMENT_SMALL_BYTES=64KB
# MIAGENT_ATTACHMENT_SEND_BUDGET=16MB
# MIAGENT_ATTACHMENT_MAX_ACTIVE=32
# MIAGENT_ATTACHMENT_RECENT_ITEMS=32
# MIAGENT_ATTACHMENT_PRESSURE_COUNT=16
# MIAGENT_ATTACHMENT_PRESSURE_BYTES=16MB
# MIAGENT_ATTACHMENT_PRESSURE_RECENT=4
# MIAGENT_RECALL_HEADROOM=8MB
# MIAGENT_REQUEST_HARD_BYTES=40MB
# MIAGENT_CACHE_SWEEP=1
# MIAGENT_SWEEP_AGGRESSION=2
# MIAGENT_SWEEP_LOW_WATERMARK=60
# MIAGENT_SWEEP_HORIZON=2
# MIAGENT_TOOL_BODY_SMALL_BYTES=8KB
# MIAGENT_TOOL_BODY_BLOB_THRESHOLD=64KB
# MIAGENT_TOOL_BODY_SEND_BUDGET=8MB
# MIAGENT_SHAKE_BODY_THRESHOLD=64KB
# MIAGENT_ATTACHMENT_STORE_MAX_BYTES=0

# Agent Skills. The activate_skill tool scans $HOME/.agents/skills, $MIAGENT_CONFIG_DIR/skills, and the project's
# .agents/skills and .miagent/skills directories. Set MIAGENT_SKILLS=0 to disable the tool entirely. Set
# MIAGENT_SKILLS_PROJECT=0 to skip the project-level scopes for an untrusted checkout; because a project's
# .miagent/.env can override this file, set that in the process environment when it matters. MIAGENT_SKILLS_DIRS adds
# more skill roots as a colon-separated list; a leading ~ is expanded and relative paths are resolved against the
# project directory. Later roots override earlier ones with the same skill name.
# MIAGENT_SKILLS=1
# MIAGENT_SKILLS_PROJECT=1
# MIAGENT_SKILLS_DIRS=$HOME/.agents/skills:$HOME/shared-skills

# Extra host directories the bash tool's sandbox mounts writable, as a colon-separated list. The sandbox keeps the
# host read-only except for the working directory and build caches: the XDG cache home ($XDG_CACHE_HOME, or ~/.cache)
# is always writable, together with a built-in list of common per-language caches (CARGO_HOME, ~/.npm,
# GRADLE_USER_HOME, GOMODCACHE, and so on) when they exist. Setting this replaces that built-in list. A leading ~ is
# expanded to $HOME, and directories named here are created if missing; the XDG cache home stays writable either way.
# MIAGENT_BASH_RW=$HOME/.cargo:$HOME/.npm
